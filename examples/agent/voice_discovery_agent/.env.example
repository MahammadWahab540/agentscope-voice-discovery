# AgentScope Voice Server Configuration
HOST=0.0.0.0
PORT=8002
PUBLIC_HOST=localhost:8002

# Security
INTERNAL_SERVICE_KEY=super-secret-internal-key

# LLM Providers (at least one required based on the model_provider used)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key

# Optional realtime model overrides
GEMINI_REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
DASHSCOPE_REALTIME_MODEL=qwen3-omni-flash-realtime
